{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "milimon",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "env": {
    "production": {
      "name": "milimon",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash",
      },
    },
    "staging": {
      "name": "milimon-staging",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash",
        "run_worker_first": ["/keystatic*", "/api/keystatic/*", "/_image"],
      },
    },
  },
}
