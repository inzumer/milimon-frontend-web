{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en,es",
  "import": ["@cspell/dict-es-es/cspell-ext.json"],
  "ignorePaths": ["dist", ".astro", "coverage", "node_modules", "pnpm-lock.yaml", "*.svg"],
  "words": [
    "Milimon",
    "inzumer",
    "zamuner",
    "fontsource",
    "astrojs",
    "napi",
    "wasi",
    "tokens",
    "IIBB",
    "RRHH",
    "PEPS",
    "Omnes",
    "Tournedó",
    "tournedo",
    "medialunas",
    "decomiso",
    "desechos",
    "mermas",
    "nvmrc",
    "cspell",
    "vitest",
    "jsdom",
    "lcov",
    "tsconfigs",
    "kebab",
    "markdoc",
    "Markdoc",
    "Renderable"
  ],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./.cspell/project-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["project-words"]
}
